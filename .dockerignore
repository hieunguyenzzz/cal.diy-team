# Dependencies
node_modules
**/node_modules

# Yarn's local package cache is gitignored and huge on dev machines; a fresh
# CI checkout never has it, but excluding it here keeps local builds honest
# too (SBS-579 - it was ballooning the .yarn COPY layer to 750MB+ locally).
.yarn/cache

# Build outputs
.next
**/.next
dist
**/dist
build
**/build

# Git
.git
.github

# Testing
coverage
**/coverage
test-results
**/test-results
.turbo
**/.turbo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Examples and docs
docs
